# Variabel yang dipakai skill HdyBot di Hermes. Taruh di ~/.hermes/.env (atau lewat `hermes config set`).
# JANGAN isi dengan nilai dari .env lama tanpa merotasi dulu (lihat BACA-DULU.md bagian Keamanan).

HDYBOT_DB=~/.hermes/hdybot/hdybot.sqlite

# --- Hanya bila kamu mem-port LMS / Drive (lihat skill hdybot-lms-drive) ---
LMS_ENCRYPTION_KEY=            # openssl rand -base64 32 ; simpan bersama backup
LMS_SYNC_MINUTES=45
GOOGLE_DRIVE_FOLDER_ID=        # ID folder materi
GOOGLE_APPLICATION_CREDENTIALS=  # path JSON akun layanan Google
GOOGLE_DRIVE_ALLOWED_CHATS=    # JID chat yang boleh menerima isi folder

# --- Opsional ---
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
